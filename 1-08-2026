import java.util.*;

public class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt(); // number of queries

        while (t-- > 0) {
            int a = sc.nextInt();
            int b = sc.nextInt();
            int n = sc.nextInt();

            int sum = a;
            int power = 1; // represents 2^i

            for (int i = 0; i < n; i++) {
                sum += power * b;
                System.out.print(sum + " ");
                power *= 2; // update 2^i
            }
            System.out.println();
        }
    }
}
